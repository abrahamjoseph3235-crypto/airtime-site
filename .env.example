# Copy to .env. Never commit .env or service-account.json.
APP_ENV=development
SECRET_KEY=change-me-generate-with-python-secrets-token-hex
DATABASE_URL=sqlite:///dev.db
AIRTIME_AMOUNT_NAIRA=100

# Required to access the private manual evidence-review dashboard.
# Set a strong unique password in your local .env; do not commit it.
ADMIN_REVIEW_PASSWORD=change-me-use-a-unique-strong-password

# Development-safe defaults: mock eligibility and mock airtime only.
VERIFIER=mock
AIRTIME_PROVIDER=mock

# Google Form used by this project
GOOGLE_FORM_ID=1FAIpQLSemqQxGTKy6PRR5SA3UXAdlk8a0gi25oXUAUhENRTsPlMSpMw
GOOGLE_FORM_VIEW_URL=https://docs.google.com/forms/d/e/1FAIpQLSemqQxGTKy6PRR5SA3UXAdlk8a0gi25oXUAUhENRTsPlMSpMw/viewform
GOOGLE_FORM_PHONE_ENTRY_ID=551363144
GOOGLE_FORM_REFERRAL_ENTRY_ID=1296999881
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# Shared rate-limit storage for multi-worker production
REDIS_URL=

# VTUAgent remains disabled unless the provider has approved the business use
# and confirmed a safe test environment. Do not use production credentials for tests.
VTUAGENT_API_KEY=
AIRTIME_VTUAGENT_BASE_URL=https://api.vtuagent.com
AIRTIME_VTUAGENT_ALLOW_REQUESTS=false
